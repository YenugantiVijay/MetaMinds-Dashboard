# The default database and application key are stored under the current user's home directory.
DATA_DIR=
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:5173
COMPANY_TIMEZONE=Asia/Kolkata
# Expected paid hours are intentionally unset until company policy is confirmed.
EXPECTED_WORKING_HOURS=8
SCHEDULED_START=10:00
SCHEDULED_END=18:00
ABSENCE_WARNING_HOURS=3
# Employee IDs are generated as MM-YYYY-NNNN after CEO approval.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and a Google App Password.
# Never use your normal Google account password. Keep credentials out of source control.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CEO_NOTIFICATION_EMAIL=
